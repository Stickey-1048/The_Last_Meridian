bool Function MineArea()
	If !Local()
		Return false
	EndIf
	float currentX = Game.GetPlayer().GetPositionX()
	float currentY = Game.GetPlayer().GetPositionY()
	Return (SurfaceArea() && currentX >= 1920.0 && currentX <= 3840.0 && currentY >= -128.0 && currentY <= 1408.0) || UndergroundArea()
EndFunction


bool Function CourtArea()
	Return Local() && SurfaceArea() && Game.GetPlayer().GetPositionX() >= -128.0 && Game.GetPlayer().GetPositionX() <= 1664.0 && Game.GetPlayer().GetPositionY() >= -128.0 && Game.GetPlayer().GetPositionY() <= 896.0
EndFunction

string Function ReportMark()
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	Return "" + Road().CourtMark() + ":" + Road().MineMark() + ":" + Road().SafeCount(SurfaceSlots) + ":" + Road().DeathCount() + ":" + Road().TLM_G_MQ02C_LampTaken.GetValueInt() + ":" + Road().TLM_G_MQ02C_Docket2298Held.GetValueInt() + ":" + Road().TermsDelivered() + ":" + Road().TLM_G_MQ02C_Entombed.GetValueInt() + ":" + Road().TLM_G_MQ02C_SilverMine.GetValueInt() + ":" + Road().TLM_G_MQ02C_SilverRoad.GetValueInt() + ":" + Road().LampOrigin() + ":" + Road().DeathCauseCount(1) + ":" + Road().DeathCauseCount(2) + ":" + Road().DeathCauseCount(3)
EndFunction


Function RecoverRescue()
	If !Ready() || Road().MinePending() != 2 || !Near(Ref(Alias_CageControl)) || !Road().At(Game.GetPlayer(),Ref(Alias_CageSurface),256.0)
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = PendingRescue.Show()
	If !Ready() || Road().MineMark() != mineBefore || !Near(Ref(Alias_CageControl))
		Return
	EndIf
	If answer == 0
		RescueShift()
	ElseIf answer == 1
		; Only the player returns; delivered miners and pending2 remain untouched.
		MovePlayer(Ref(Alias_CageBelow))
	EndIf
EndFunction

Function RegisterClockMenus()
	lastSample = -1.0
	lastArea = 0
	menusRegistered = false
	If !ClockMenus || ClockMenus.Length != 26
		menuUncertain = true
		Return
	EndIf
	If !menuStates || menuStates.Length != ClockMenus.Length
		menuStates = new bool[26]
	EndIf
	int menuIndex = 0
	While menuIndex < ClockMenus.Length
		RegisterForMenuOpenCloseEvent(ClockMenus[menuIndex])
		menuIndex += 1
	EndWhile
	menusRegistered = true
EndFunction

bool Function KnownMenuOpen()
	If !menuStates
		Return false
	EndIf
	int menuIndex = 0
	While menuIndex < menuStates.Length
		If menuStates[menuIndex]
			Return true
		EndIf
		menuIndex += 1
	EndWhile
	Return false
EndFunction

Event OnMenuOpenCloseEvent(string asMenuName, bool abOpening)
	; Both edges discard the interval, including a menu wholly between ticks.
	lastSample = -1.0
	lastArea = 0
	If !ClockMenus || !menuStates
		menuUncertain = true
		Return
	EndIf
	int menuIndex = 0
	While menuIndex < ClockMenus.Length
		If ClockMenus[menuIndex] == asMenuName
			menuStates[menuIndex] = abOpening
			Return
		EndIf
		menuIndex += 1
	EndWhile
	; No wildcard API exists. An unexpected delivered name never earns time.
	menuUncertain = true
	Road().BlockDeadline()
	Road().StopWatching()
EndEvent


; Presentation only; no new outcome, inventory, reward or evidence receipt.
bool Function AftermathContext(Actor speakerActor, bool isRoark, Actor playerActor, int generation)
	If !playerActor || playerActor.IsDead() || playerActor.IsDisabled() || playerActor.IsInCombat() || !playerActor.Is3DLoaded() || !TalkOK(speakerActor) || playerActor.IsInScene() || speakerActor.IsInScene() || speakerActor.IsInDialogueWithPlayer() || !SurfaceArea()
		Return false
	EndIf
	Actor currentSpeaker = Alias_Blevins.GetActorReference()
	Actor roadSpeaker = Road().Person(Road().Alias_Blevins)
	ObjectReference originalSpeaker = RhaOriginalBlevins
	If isRoark
		currentSpeaker = Alias_Roark.GetActorReference()
		roadSpeaker = Road().Person(Road().Alias_Roark)
		originalSpeaker = RhaOriginalRoark
	EndIf
	; Scene/dialogue/region/alias reads can yield; refresh participants after those reads.
	If !TalkOK(speakerActor) || playerActor.IsDisabled() || playerActor.IsInCombat() || !playerActor.Is3DLoaded() || speakerActor.IsDead() || playerActor.IsDead()
		Return false
	EndIf
	Return speakerActor == originalSpeaker && speakerActor == currentSpeaker && speakerActor == roadSpeaker && playerActor == Game.GetPlayer() && generation == aftermathEpoch
EndFunction

int Function AftermathRow()
	int resultCode = Road().MineOutcome()
	If Road().MinePending() != 0 || !Road().GetStageDone(resultCode)
		Return -1
	EndIf
	If resultCode == 53 || resultCode == 56
		If Road().TLM_G_MQ02C_MouthShut.GetValueInt() == 1 && Road().Off(Ref(Alias_MouthOpen)) && Road().On(Ref(Alias_MouthClosed))
			Return resultCode
		EndIf
		Return -1
	EndIf
	If resultCode != 51 && resultCode != 52 && resultCode != 57 && resultCode != 58
		Return -1
	EndIf
	If !SurfaceSlots || SurfaceSlots.Length != 11 || !Road().KnownSafeSurvivors(SurfaceSlots) || !Road().DistinctRoster() || !Road().RHSurfaceReceipts || Road().RHSurfaceReceipts.Length != 11
		Return -1
	EndIf
	int index = 0
	While index < 11
		Actor minerActor = Road().Miner(index)
		ObjectReference slotRef = Ref(SurfaceSlots[index])
		If !minerActor || minerActor != Road().RHOriginalMiners[index] || !slotRef || slotRef != Road().RHSurfaceReceipts[index]
			Return -1
		EndIf
		If minerActor.IsDead()
			If Road().Fate(index) != 4
				Return -1
			EndIf
		ElseIf minerActor.IsDisabled() || !minerActor.Is3DLoaded() || !Road().At(minerActor,slotRef)
			Return -1
		EndIf
		index += 1
	EndWhile
	int safeNumber = Road().SafeCount(SurfaceSlots)
	If safeNumber + Road().DeathCount() != 11
		Return -1
	EndIf
	Return safeNumber
EndFunction

string Function AftermathMark()
	Return "" + Road().MineMark() + ":" + Road().TermsDelivered() + ":" + Road().TLM_G_MQ02C_BreakBlown.GetValueInt() + ":" + Road().TLM_G_MQ02C_MouthShut.GetValueInt() + ":" + AftermathRow()
EndFunction

