		EndIf
		Return RhaBlevinsAll
	EndIf
	If row == 0
		If isRoark
			Return RhaRoarkNone
		EndIf
		Return RhaBlevinsNone
	EndIf
	If row == 1
		If isRoark
			Return RhaRoarkPartial1
		EndIf
		Return RhaBlevinsPartial1
	EndIf
	If row == 2
		If isRoark
			Return RhaRoarkPartial2
		EndIf
		Return RhaBlevinsPartial2
	EndIf
	If row == 3
		If isRoark
			Return RhaRoarkPartial3
		EndIf
