		answer = D_quill_docket_3.Show()
		If answer != 0 || !Near(paperRef)
			Return false
		EndIf
	ElseIf paperId == "docket_2298"
		answer = D_docket_2298_1.Show()
		If answer != 0 || !Near(paperRef) || !Road().HoldsDocket()
			Return false
		EndIf
		answer = D_docket_2298_2.Show()
		If answer != 0 || !Near(paperRef) || !Road().HoldsDocket()
			Return false
		EndIf
		answer = D_docket_2298_3.Show()
		If answer != 0 || !Near(paperRef) || !Road().HoldsDocket()
			Return false
		EndIf
		answer = D_docket_2298_4.Show()
		If answer != 0 || !Near(paperRef) || !Road().HoldsDocket()
			Return false
		EndIf
	ElseIf paperId == "chalk_message"
		answer = D_chalk_message_1.Show()
		If answer != 0 || !Near(paperRef)
			Return false
		EndIf
		answer = D_chalk_message_2.Show()
		If answer != 0 || !Near(paperRef)
			Return false
		EndIf
	Else
		Return false
	EndIf
	Return true
EndFunction

bool Function OpenDoor()
	If !IsRunning()
		If !Start() || !IsRunning()
			Return false
		EndIf
	EndIf
	If Ref(Alias_MercyTravel)
		Ref(Alias_MercyTravel).Enable()
	EndIf
	lastSample = -1.0
	RegisterClockMenus()
	StartTimer(1.0, 1)
	Return true
EndFunction

Function Loaded()
	If !IsRunning()
		Return
	EndIf
	RegisterClockMenus()
	; Never charge real save/load downtime or replay a missed timer interval.
	lastSample = -1.0
	ArmRope()
	StartTimer(1.0, 1)
EndFunction

bool Function SetUp()
	If !IsRunning() || !Road().Commissioned()
		Return false
	EndIf
	If !TLM_MQ02C.IsRunning()
		If !TLM_MQ02C.Start() || !TLM_MQ02C.IsRunning()
			Return false
		EndIf
	EndIf
	RegisterClockMenus()
	If setUpDone
		StagePrisoner()
		Return true
	EndIf
	int castIndex = 0
	While castIndex < CastFrom.Length
		If !Ref(CastFrom[castIndex])
			Return false
		EndIf
		CastInto[castIndex].ForceRefTo(Ref(CastFrom[castIndex]))
		castIndex += 1
	EndWhile
	castIndex = 0
	While castIndex < ZoneOn.Length
		If Ref(ZoneOn[castIndex])
			Ref(ZoneOn[castIndex]).Enable()
		EndIf
		castIndex += 1
	EndWhile
	setUpDone = Road().DistinctRoster()
	Road().GiveKey()
	StagePrisoner()
	ArmRope()
	Return setUpDone
EndFunction

Function StagePrisoner()
	If !IsRunning() || !TLM_MQ02C.IsRunning() || !setUpDone || !Road().Commissioned() || Road().HasPrisoner() || Road().CourtOutcome() != 0 || Road().CourtPending() != 0 || Ref(Alias_Condemned)
		Return
	EndIf
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	If !original
		Return
	EndIf
	Actor candidate = original.Alias_CutterLead.GetActorReference()
	int roleIndex = 1
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterA.GetActorReference()
		roleIndex = 2
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterB.GetActorReference()
		roleIndex = 3
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterC.GetActorReference()
		roleIndex = 4
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		Return
	EndIf
	candidate.Enable()
	candidate.MoveTo(Ref(Alias_Gallows))
	If Road().BindPrisoner(candidate, roleIndex, Ref(Alias_Gallows))
		Alias_Condemned.ForceRefTo(candidate)
	EndIf
EndFunction

Function ArmRope()
	If Road() && Road().CourtOutcome() == 0 && Ref(Alias_Rope)
		; ScriptObject registration is single-shot; rejected hits and load rearm it.
		RegisterForHitEvent(Ref(Alias_Rope), Game.GetPlayer())
	EndIf
EndFunction

Event OnHit(ObjectReference akTarget, ObjectReference akAggressor, Form akSource, Projectile akProjectile, bool abPowerAttack, bool abSneakAttack, bool abBashAttack, bool abHitBlocked, string asMaterialName)
	If !busy && Local() && akTarget == Ref(Alias_Rope) && akAggressor == Game.GetPlayer() && akProjectile && !abBashAttack && !abHitBlocked && Road().StartRope(akTarget, true)
		busy = true
		ReleasePrisoner()
		busy = false
		lastSample = -1.0
	EndIf
	ArmRope()
EndEvent

bool Function ReleasePrisoner()
	Actor prisonerActor = Alias_Condemned.GetActorReference()
	If !Ready() || !prisonerActor || prisonerActor.IsDead() || prisonerActor.IsInCombat()
		Return false
	EndIf
	If Road().CourtPending() == 11
		Ref(Alias_Rope).Disable()
		Ref(Alias_RopeBroken).Enable()
	EndIf
	prisonerActor.MoveTo(Ref(Alias_Released))
	If Road().FinishRelease(Ref(Alias_Released), Ref(Alias_Rope), Ref(Alias_RopeBroken))
		; No forty-yard boast or future companion system is claimed.
		Return true
	EndIf
	Return false
EndFunction

bool Function ShiftSafeToSpeak()
	Return Road().AllAliveBelow(BelowSlots) && Road().MineOutcome() == 0 && Road().MinePending() == 0
EndFunction

Function CourtTalk()
	Actor judgeActor = Alias_Quill.GetActorReference()
	If !TalkOK(judgeActor)
		Return
	EndIf
	If Road().ReferralDue()
		ReferDockets()
		Return
	EndIf
	If Road().CourtPending() == 12
		FineRelease()
		Return
	EndIf
	If Road().CourtPending() == 13
		Custody()
		Return
	EndIf
	If !Ref(Alias_Condemned)
		Unavailable.Show()
		Return
	EndIf
	If !Road().CourtOpen()
		Status.Show()
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	bool heldCopy = Road().HoldsDocket()
	int answer = -1
	If heldCopy
		answer = Say("quill_court_docket", judgeActor)
	Else
		answer = Say("quill_court", judgeActor)
	EndIf
	If answer == -1 || !TalkOK(judgeActor) || Road().CourtMark() != courtBefore || !Road().CourtOpen()
		Return
	EndIf
	If answer == 0
		If Say("quill_fine", judgeActor) == 0 && TalkOK(judgeActor) && Road().CourtMark() == courtBefore && Road().CourtOpen()
			FineRelease()
		EndIf
	ElseIf answer == 1 && heldCopy && Road().HoldsDocket()
		If Say("quill_shamed", judgeActor) == 0 && TalkOK(judgeActor) && Road().HoldsDocket() && Road().CourtMark() == courtBefore && Road().StartAdjournment()
			Custody()
		EndIf
	EndIf
EndFunction

Function FineRelease()
	If !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned)
		Return
	EndIf
	If Road().StartFine(Ref(Alias_TollBox)) && Road().GiveReceipt()
		int answer = Receipt.Show()
		If answer == 0 && TalkOK(Alias_Quill.GetActorReference()) && Road().Speaking(Alias_Condemned)
			ReleasePrisoner()
		EndIf
	EndIf
EndFunction

Function Custody()
	If !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned) || !Road().HoldsDocket()
		Return
	EndIf
	Alias_Condemned.GetActorReference().MoveTo(Ref(Alias_Custody))
	If Road().FinishAdjournment(Ref(Alias_Custody))
		ReferDockets()
	EndIf
EndFunction

Function ReferDockets()
	If !Road().ReferralDue() || !Road().HoldsDocket() || !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned)
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Referral.Show()
	If answer != 0 || !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned) || !Road().HoldsDocket() || Road().CourtMark() != courtBefore
		Return
	EndIf
	Ref(Alias_ReferralSent).Enable()
	Road().FinishReferral(Ref(Alias_ReferralSent))
EndFunction

Function PrisonerTalk()
	Actor prisonerActor = Alias_Condemned.GetActorReference()
	If !TalkOK(prisonerActor)
		Return
	EndIf
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	int answer = -1
	If prisonerActor == original.Alias_CutterLead.GetActorReference()
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			answer = Say("dunmore_rope_missed", prisonerActor)
		Else
			answer = Say("dunmore_rope", prisonerActor)
			If answer == 0
				answer = Say("dunmore_tells", prisonerActor)
			EndIf
		EndIf
	Else
		; Cutter lines say Reese is dead. A merely unavailable/combat lead is insufficient.
		Actor leadActor = original.Alias_CutterLead.GetActorReference()
		If !leadActor || !leadActor.IsDead()
			Prisoner.Show()
			Return
		EndIf
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			answer = Say("cutter_rope_missed", prisonerActor)
		Else
			answer = Say("cutter_rope", prisonerActor)
		EndIf
	EndIf
	If answer == 0 && TalkOK(prisonerActor)
		Road().RecordStatement()
	EndIf
EndFunction

Function RoarkTalk()
	Actor roarkActor = Alias_Roark.GetActorReference()
	If !TalkOK(roarkActor)
		Return
	EndIf
	If Road().PactMade() && Road().SafeCount(SurfaceSlots) == 11
		; Compound kitchen, elapsed-knocking and feeding claims are withheld.
		Road().DeliverTerms()
		Facts()
		Return
	EndIf
	If !ShiftSafeToSpeak() || !Road().OperatorReady(Ref(Alias_FiringControl))
		Status.Show()
		Return
	EndIf
	int answer = Say("roark_mouth", roarkActor)
	If answer == 0
		Warn(roarkActor)
	ElseIf answer == 1
		Say("roark_why", roarkActor)
	ElseIf answer == 2 && Road().HeardKnocking()
		Say("roark_back", roarkActor)
	EndIf
EndFunction

Function Warn(Actor roarkActor)
	If !TalkOK(roarkActor) || !Road().HeardKnocking() || !ShiftSafeToSpeak()
		Return
	EndIf
	int answer = Say("roark_deadline_warning", roarkActor)
	If answer != 0 && answer != 1
		Return
	EndIf
	If !TalkOK(roarkActor) || !ShiftSafeToSpeak() || !Road().OperatorReady(Ref(Alias_FiringControl))
		Return
	EndIf
	int clockAnswer = Clock.Show()
	If clockAnswer == 0 && menusRegistered && TalkOK(roarkActor) && ShiftSafeToSpeak() && Road().OperatorReady(Ref(Alias_FiringControl))
		menuUncertain = false
		Road().AcceptRescue(true, Ref(Alias_FiringControl))
		Debug.Notification("Red Hollow: " + Road().SecondsLeft() + " active seconds remain; menus and absence pause the deadline.")
	EndIf
EndFunction

Function BlevinsTalk()
	Actor captainActor = Alias_Blevins.GetActorReference()
	If !TalkOK(captainActor) || !ShiftSafeToSpeak()
		Return
	EndIf
	int answer = -1
	If Road().HeardKnocking()
		answer = Say("greer_first_heard", captainActor)
	Else
		answer = Say("greer_first", captainActor)
	EndIf
	If answer == 0
		Say("greer_knock", captainActor)
	ElseIf answer == 1
		Say("greer_lamp", captainActor)
	ElseIf answer == 2 && Road().HeardKnocking()
		Fire(true)
	EndIf
EndFunction

Function DornTalk()
	Actor wardenActor = Alias_Dorn.GetActorReference()
	If !TalkOK(wardenActor) || !Road().DornAvailable() || !ShiftSafeToSpeak() || !Road().AtGallery()
		Return
	EndIf
	int answer = Say("dorn_door", wardenActor)
	If answer == 0
		answer = Say("dorn_terms", wardenActor)
		If answer == 0
			Pledge(wardenActor)
		ElseIf answer == 1
			answer = Say("dorn_no_head", wardenActor)
			If answer == 0
				Pledge(wardenActor)
			ElseIf answer == 1 && TalkOK(wardenActor)
				Road().PlanBreak()
			EndIf
		ElseIf answer == 2 && TalkOK(wardenActor)
			Road().PlanBreak()
		EndIf
	ElseIf answer == 1
		Say("dorn_who", wardenActor)
	ElseIf answer == 2 && TalkOK(wardenActor)
		Road().PlanBreak()
	ElseIf answer == 3 && TalkOK(wardenActor)
		TakeLamp(1)
	EndIf
EndFunction

Function Pledge(Actor wardenActor)
	If !TalkOK(wardenActor) || !Road().DornAvailable() || !ShiftSafeToSpeak()
		Return
	EndIf
	If Say("dorn_sworn", wardenActor) == 0 && TalkOK(wardenActor) && ShiftSafeToSpeak()
		Road().MakePact()
	EndIf
EndFunction

Function TakeLamp(int originCode)
	ObjectReference lampRef = Ref(Alias_GalleryLamp)
	If originCode == 2
		lampRef = Ref(Alias_CotLamp)
	EndIf
	If !Near(lampRef) || (Road().LampOrigin() != 0 && !Road().LampPending(originCode))
		Return
	EndIf
	Actor witnessActor = Alias_Dorn.GetActorReference()
	bool witnessed = originCode == 1 && TalkOK(witnessActor) && Road().DornAvailable()
	int answer = Lamp.Show()
	If answer != 0 || !Near(lampRef) || (Road().LampOrigin() != 0 && !Road().LampPending(originCode))
		Return
	EndIf
	If Road().GiveLamp(originCode)
		lampRef.Disable()
		Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
		If witnessed && originCode == 1 && TalkOK(witnessActor) && Road().DornAvailable()
			Say("dorn_lamp", witnessActor)
		EndIf
	EndIf
EndFunction

bool Function MovePlayer(ObjectReference targetRef)
	If !Road().PlayerAlive() || !targetRef
		Return false
	EndIf
	Game.GetPlayer().MoveTo(targetRef)
	lastSample = -1.0
	Return Road().PlayerAlive() && Road().At(Game.GetPlayer(),targetRef)
EndFunction

Function UseHoist()
	If !Ready() || !Road().On(Ref(Alias_MouthOpen)) || !Road().Off(Ref(Alias_MouthClosed)) || (Road().MinePending() != 0 && Road().MinePending() != 1) || Road().MineOutcome() != 0
		Return
	EndIf
	If !Road().RescueAccepted()
		; Player-operated fallback if Roark/Blevins is dead, absent or ineligible.
		If !Road().HeardKnocking()
			Return
		EndIf
		If !Road().OperatorReady(Ref(Alias_FiringControl))
			int noOpAnswer = NoOperator.Show()
			If noOpAnswer != 0 || !Ready() || Road().OperatorReady(Ref(Alias_FiringControl)) || !Road().AcceptRescue(false,Ref(Alias_FiringControl))
				Return
			EndIf
		Else
			int clockAnswer = NoWarning.Show()
			If clockAnswer != 0 || !Ready() || !Road().AcceptRescue(false,Ref(Alias_FiringControl))
				Return
			EndIf
		EndIf
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Descend.Show()
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore
		Return
	EndIf
	If Road().MinePending() == 1 || Road().BeginDescent()
		If MovePlayer(Ref(Alias_CageBelow))
			Road().FinishDescent(Ref(Alias_CageBelow))
		EndIf
	EndIf
EndFunction

Function RescueShift()
	If !Ready() || !Road().ShiftFound() || (Road().MinePending() != 0 && Road().MinePending() != 2)
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Rescue.Show()
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore || !Road().BeginRescue()
		Return
	EndIf
	int minerIndex = 0
	While minerIndex < 11
		Actor minerActor = Road().Miner(minerIndex)
		If !Ready() || !minerActor || minerActor.IsDisabled()
			Return
		EndIf
		If minerActor.IsDead()
			; The death must have been observed by the local alias callback or a nearby inspection.
			If Road().Fate(minerIndex) != 4 && !Road().ObserveDeliveredDeath(minerIndex)
				Return
			EndIf
		ElseIf Road().At(minerActor,Ref(SurfaceSlots[minerIndex]))
			Road().ObserveAt(minerIndex,Ref(SurfaceSlots[minerIndex]),3)
		Else
			minerActor.MoveTo(Ref(CageSlots[minerIndex]))
			If !Road().ObserveAt(minerIndex,Ref(CageSlots[minerIndex]),2)
				Return
			EndIf
		EndIf
		minerIndex += 1
	EndWhile
	If !MovePlayer(Ref(Alias_CageSurface))
		Return
	EndIf
	minerIndex = 0
	While minerIndex < 11
		Actor minerActor = Road().Miner(minerIndex)
		If !Ready() || !minerActor || minerActor.IsDisabled()
			Return
		EndIf
		If !minerActor.IsDead() && Road().Fate(minerIndex) != 3
			minerActor.MoveTo(Ref(SurfaceSlots[minerIndex]))
			If !Road().ObserveAt(minerIndex,Ref(SurfaceSlots[minerIndex]),3)
				Return
			EndIf
		EndIf
		minerIndex += 1
	EndWhile
	Road().FinishRescue(SurfaceSlots)
	Facts()
EndFunction

Function BlastBreak()
	If !Near(Ref(Alias_BreakControl)) || (Road().MinePending() != 0 && Road().MinePending() != 3)
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Blast.Show()
	If answer != 0 || !Near(Ref(Alias_BreakControl)) || Road().MineMark() != mineBefore || !Road().ClearBlastArea(Ref(Alias_BreakClosed))
		Return
	EndIf
	If Road().MinePending() == 3 || Road().BeginBreak(SurfaceSlots)
		Ref(Alias_BreakOpen).Disable()
		Ref(Alias_BreakClosed).Enable()
		Road().FinishBreak(Ref(Alias_BreakOpen),Ref(Alias_BreakClosed),Ref(Alias_BreakClosed),SurfaceSlots)
	EndIf
EndFunction

Function Fire(bool ordered)
	If !Ready() || Road().MinePending() != 0 || Road().MineOutcome() != 0 || !Road().HeardKnocking() || !Road().AllBelow(BelowSlots,CageSlots) || !Road().OperatorReady(Ref(Alias_FiringControl))
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = -1
	If ordered
		answer = Seal.Show()
	Else
		answer = Final.Show()
	EndIf
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore || !Road().OperatorReady(Ref(Alias_FiringControl)) || !Road().AllBelow(BelowSlots,CageSlots)
		Road().BlockDeadline()
		Return
	EndIf
	If Road().BeginFire(ordered,Ref(Alias_FiringControl),BelowSlots,CageSlots,Ref(Alias_MouthOpen),Ref(Alias_MouthClosed))
		FinishFiring()
	EndIf
EndFunction

bool Function FiringContext()
	Return Ready() && (Road().MinePending() == 4 || Road().MinePending() == 5) && Road().OperatorReady(Ref(Alias_FiringControl)) && Road().AllBelow(BelowSlots,CageSlots)
EndFunction

Function RestoreAbortedFiring()
	If Road().MineOutcome() == 0
		Road().AbortFiring()
		Ref(Alias_MouthClosed).Disable()
		Ref(Alias_MouthOpen).Enable()
	EndIf
EndFunction

Function ResumeFiring()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = -1
	If Road().MinePending() == 4
		answer = Seal.Show()
	Else
		answer = Final.Show()
	EndIf
	If answer != 0 || Road().MineMark() != mineBefore || !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	FinishFiring()
EndFunction

Function FinishFiring()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	If !MovePlayer(Ref(Alias_CageSurface))
		; Keep the acknowledged intent; the below/surface cage has a labelled retry.
		Return
	EndIf
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Ref(Alias_MouthOpen).Disable()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Ref(Alias_MouthClosed).Enable()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Road().FinishFire(Ref(Alias_FiringControl),Ref(Alias_MouthOpen),Ref(Alias_MouthClosed),Ref(Alias_CageSurface),BelowSlots,CageSlots)
EndFunction

Function Facts()
	Road().PublishSurvivors(SurfaceSlots)
	Debug.Notification("Red Hollow: safe survivors " + Road().SafeCount(SurfaceSlots) + "; observed deaths " + Road().DeathCount() + ".")
	Debug.Notification("Court outcome " + Road().CourtOutcome() + "; mine outcome " + Road().MineOutcome() + "; unfinished scene " + Road().MinePending() + ".")
EndFunction

Function Used(int who)
	If busy || !Road().PlayerAlive()
		Return
	EndIf
	busy = true
	UseControl(who)
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	busy = false
	lastSample = -1.0
EndFunction

Function UseControl(int who)
	If who == 1
		If !Road().Commissioned() || !Near(Ref(Alias_MercyTravel))
			; Mercy is outside Local(); use direct same-cell reach instead.
			If !Road().Commissioned() || !Road().At(Game.GetPlayer(),Ref(Alias_MercyTravel),256.0)
				Return
			EndIf
		EndIf
		int answer = Travel.Show()
		If answer == 0 && Road().Commissioned() && Road().At(Game.GetPlayer(),Ref(Alias_MercyTravel),256.0) && SetUp() && MovePlayer(Ref(Alias_GapArrival))
			Road().ArriveAtGap(Ref(Alias_GapArrival))
		EndIf
		Return
	EndIf
	If !Ready() || !Local()
		Return
	EndIf
	If who == 2 || who == 7 || who == 13
		StagePrisoner()
	EndIf
	If who == 2
		CourtTalk()
	ElseIf who == 3
		RoarkTalk()
	ElseIf who == 32 && Local() && Road().At(Game.GetPlayer(),Ref(Alias_Gallows),512.0)
		Road().FinishExecution(Ref(Alias_Gallows))
	EndIf
	If who == 4
		BlevinsTalk()
	ElseIf who == 5 || who == 28
		DornTalk()
	ElseIf who == 6
		If Near(Ref(Alias_Rope))
			Rope.Show()
		ElseIf Road().CourtPending() == 11
			ReleasePrisoner()
		EndIf
	ElseIf who == 7 || who == 13
		CourtMenu()
	ElseIf who == 8
		Paper("toll_board",Ref(Alias_TollBoard))
	ElseIf who == 9
		Paper("quill_docket",Ref(Alias_Docket))
	ElseIf who == 10
		ReadStatement()
	ElseIf who == 11 && Near(Ref(Alias_TollBox))
		Road().PayToll(Ref(Alias_TollBox))
	ElseIf who == 12 && Near(Ref(Alias_Bypass))
		Road().Bypass()
	ElseIf who == 14 && Near(Ref(Alias_ToMouth))
		TravelLocal(Ref(Alias_ToMouth),Ref(Alias_MouthArrival))
	ElseIf who == 15 && Near(Ref(Alias_ToGap))
		TravelLocal(Ref(Alias_ToGap),Ref(Alias_GapArrival))
	ElseIf who == 16 && Near(Ref(Alias_CageControl))
		If Road().MinePending() == 2
			RecoverRescue()
		ElseIf Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
		Else
			UseHoist()
		EndIf
	ElseIf who == 17 && Near(Ref(Alias_BelowControl))
		If Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
			Return
		EndIf
		int mineBefore = Road().MineMark()
		int answer = HoistBelow.Show()
		If Near(Ref(Alias_BelowControl)) && Road().MineMark() == mineBefore
			If answer == 0
				RescueShift()
			ElseIf answer == 1 && Road().MinePending() == 0
				MovePlayer(Ref(Alias_CageSurface))
			EndIf
		EndIf
	ElseIf who == 18 && Near(Ref(Alias_FiringControl))
		If Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
		Else
			Fire(true)
		EndIf
	ElseIf who == 19
		BlastBreak()
	ElseIf who == 20 && Near(Ref(Alias_Roster))
		ObserveNearbyDeaths()
		Road().FindShift(BelowSlots)
		Facts()
	ElseIf who == 21 && Near(Ref(Alias_Gallery))
		If Road().GalleryOpen() && TravelLocal(Ref(Alias_Gallery),Ref(Alias_GalleryArrival))
			Road().VisitGallery(Ref(Alias_GalleryArrival))
		EndIf
	ElseIf who == 22 && Near(Ref(Alias_FromGallery))
		TravelLocal(Ref(Alias_FromGallery),Ref(Alias_CageBelow))
	ElseIf who == 23
		TakeLamp(1)
	ElseIf who == 24
		TakeLamp(2)
	ElseIf who == 25 && Near(Ref(Alias_Silver))
		int answer = Silver.Show()
		If answer == 0 && Near(Ref(Alias_Silver))
			Road().LearnMineSilver()
		EndIf
	ElseIf who == 26
		Paper("chalk_message",Ref(Alias_Shovel))
	ElseIf who == 27 && Near(Ref(Alias_Knocking))
		int answer = Knocking.Show()
		If answer == 0 && Near(Ref(Alias_Knocking))
			Road().HearKnocking()
		EndIf
	ElseIf who == 29 && Near(Ref(Alias_Exit))
		int mineBefore = Road().MineMark()
		int answer = Exit.Show()
		If answer == 0 && Near(Ref(Alias_Exit)) && Road().MineMark() == mineBefore && Road().MinePending() == 0 && MovePlayer(Ref(Alias_MercyReturn))
			If Road().CompleteAtMercy(Ref(Alias_MercyReturn))
				End.Show()
			EndIf
		EndIf
	ElseIf who == 30 && Near(Ref(Alias_Resolve))
		int mineBefore = Road().MineMark()
		int answer = Resolve.Show()
		If Near(Ref(Alias_Resolve)) && Road().MineMark() == mineBefore
			If answer == 0
				Road().ResolveRescue(SurfaceSlots,true)
			ElseIf answer == 1
				Road().PlanBreak()
			ElseIf answer == 2
				Road().ResolveCasualties(SurfaceSlots)
			EndIf
		EndIf
		Facts()
	ElseIf who == 31 && Near(Ref(Alias_BodyKey))
		Road().TakeBodyKey()
	ElseIf who == 32
		PrisonerTalk()
	ElseIf who >= 40 && who <= 44
		ShowLabel(who)
	ElseIf who >= 101 && who <= 111
		int minerIndex = who - 101
		If Near(Road().Miner(minerIndex)) && Road().Miner(minerIndex).IsDead()
			Road().ObserveDeath(minerIndex)
		EndIf
		Facts()
	EndIf
EndFunction

bool Function TravelLocal(ObjectReference controlRef, ObjectReference intoRef)
	If !Near(controlRef) || Road().MinePending() != 0
		Return false
	EndIf
	int mineBefore = Road().MineMark()
	int answer = StageTravel.Show()
	If answer != 0 || !Near(controlRef) || Road().MineMark() != mineBefore
		Return false
	EndIf
	If intoRef == Ref(Alias_GalleryArrival) && !Road().GalleryOpen()
		Return false
	EndIf
	Return MovePlayer(intoRef)
EndFunction

Function CourtMenu()
	If !Near(Ref(Alias_CourtRecord)) && !Near(Ref(Alias_Watch))
		Return
	EndIf
	If Road().CourtPending() == 11
		ReleasePrisoner()
		Return
	ElseIf Road().CourtPending() == 14
		If !Road().FinishExecution(Ref(Alias_Gallows)) && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
			int retryAnswer = Drop.Show()
			If retryAnswer == 0 && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
				Road().RequestExecution()
				Road().FinishExecution(Ref(Alias_Gallows))
			EndIf
		EndIf
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Court.Show()
	If !Local() || !Ready() || Road().CourtMark() != courtBefore
		Return
	EndIf
	If answer == 0
		CourtTalk()
	ElseIf answer == 1
		WatchCourt()
	ElseIf answer == 2
		int fineAnswer = Fine.Show()
		If !Local() || !Ready() || Road().CourtMark() != courtBefore || !TalkOK(Alias_Quill.GetActorReference())
			Return
		EndIf
		If fineAnswer == 0
			Road().RecordRope(Ref(Alias_CourtRecord))
		ElseIf fineAnswer == 1
			Road().PayRope(Ref(Alias_TollBox))
		EndIf
	EndIf
EndFunction

Function WatchCourt()
	If !menusRegistered || !Road().CourtOpen() || !TalkOK(Alias_Quill.GetActorReference())
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Watch.Show()
	If answer == 0 && Road().CourtMark() == courtBefore && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
		menuUncertain = false
		Road().BeginWatch()
	EndIf
EndFunction

Function ObserveNearbyDeaths()
	int minerIndex = 0
	While minerIndex < 11
		If Near(Road().Miner(minerIndex),512.0) && Road().Miner(minerIndex).IsDead()
			Road().ObserveDeath(minerIndex)
		EndIf
		minerIndex += 1
	EndWhile
EndFunction

Function ReadStatement()
	If !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
		NoTranscript.Show()
		Return
	EndIf
	string node = "dunmore_tells"
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	If Alias_Condemned.GetActorReference() != original.Alias_CutterLead.GetActorReference()
		node = "cutter_rope"
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			node = "cutter_rope_missed"
		EndIf
	EndIf
	If Transcript(node) && Near(Ref(Alias_Transcript)) && Road().HasStatement()
		Road().RecordStatement(true)
	EndIf
EndFunction

