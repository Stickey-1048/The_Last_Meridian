EndFunction

Function ReferDockets()
	If !Road().ReferralDue() || !Road().HoldsDocket() || !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned)
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Referral.Show()
	If answer != 0 || !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned) || !Road().HoldsDocket() || Road().CourtMark() != courtBefore
		Return
	EndIf
	Ref(Alias_ReferralSent).Enable()
	Road().FinishReferral(Ref(Alias_ReferralSent))
EndFunction

Function PrisonerTalk()
	Actor prisonerActor = Alias_Condemned.GetActorReference()
	If !TalkOK(prisonerActor)
		Return
	EndIf
	If Road().CourtOutcome() == 11 || Road().CourtOutcome() == 12
		If Road().At(prisonerActor,Ref(Alias_Released)) && prisonerActor == Road().Person(Road().Alias_Condemned) && prisonerActor == Alias_Condemned.GetActorReference()
			Debug.MessageBox("Freed prisoner: I'm clear of the rope.")
		EndIf
		Return
	EndIf
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	int answer = -1
	If prisonerActor == original.Alias_CutterLead.GetActorReference()
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			answer = Say("dunmore_rope_missed", prisonerActor)
		Else
			answer = Say("dunmore_rope", prisonerActor)
			If answer == 0
				answer = Say("dunmore_tells", prisonerActor)
			EndIf
		EndIf
	Else
		; Cutter lines say Reese is dead. A merely unavailable/combat lead is insufficient.
		Actor leadActor = original.Alias_CutterLead.GetActorReference()
		If !leadActor || !leadActor.IsDead()
			Prisoner.Show()
			Return
		EndIf
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			answer = Say("cutter_rope_missed", prisonerActor)
		Else
			answer = Say("cutter_rope", prisonerActor)
		EndIf
	EndIf
	If answer == 0 && TalkOK(prisonerActor)
		Road().RecordStatement()
	EndIf
EndFunction

Function RoarkTalk()
	Actor roarkActor = Alias_Roark.GetActorReference()
	If !TalkOK(roarkActor)
		Return
	EndIf
	If Road().PactMade() && AftermathRow() == 11 && AftermathContext(roarkActor,true,Game.GetPlayer(),aftermathEpoch)
		; Compound kitchen, elapsed-knocking and feeding claims are withheld.
		Road().DeliverTerms()
		Aftermath(roarkActor,true)
		Facts()
		Return
	EndIf
	If Road().MineOutcome() != 0 || Road().MinePending() != 0
		If !Aftermath(roarkActor,true)
			Facts()
		EndIf
		Return
	EndIf
	If !ShiftSafeToSpeak() || !Road().OperatorReady(Ref(Alias_FiringControl))
		Status.Show()
		Return
	EndIf
	int answer = Say("roark_mouth", roarkActor)
	If answer == 0
		Warn(roarkActor)
	ElseIf answer == 1
		Say("roark_why", roarkActor)
	ElseIf answer == 2 && Road().HeardKnocking()
		Say("roark_back", roarkActor)
	EndIf
EndFunction

Function Warn(Actor roarkActor)
	If !TalkOK(roarkActor) || !Road().HeardKnocking() || !ShiftSafeToSpeak()
		Return
	EndIf
	int answer = Say("roark_deadline_warning", roarkActor)
	If answer != 0 && answer != 1
		Return
	EndIf
	If !TalkOK(roarkActor) || !ShiftSafeToSpeak() || !Road().OperatorReady(Ref(Alias_FiringControl))
		Return
	EndIf
	int clockAnswer = Clock.Show()
	If clockAnswer == 0 && menusRegistered && TalkOK(roarkActor) && ShiftSafeToSpeak() && Road().OperatorReady(Ref(Alias_FiringControl))
		menuUncertain = false
		Road().AcceptRescue(true, Ref(Alias_FiringControl))
		Debug.Notification("Red Hollow: " + Road().SecondsLeft() + " active seconds remain; menus and absence pause the deadline.")
	EndIf
EndFunction

Function BlevinsTalk()
	Actor captainActor = Alias_Blevins.GetActorReference()
	If TalkOK(captainActor) && (Road().MineOutcome() != 0 || Road().MinePending() != 0)
		If !Aftermath(captainActor,false)
			Facts()
		EndIf
		Return
	EndIf
	If !TalkOK(captainActor) || !ShiftSafeToSpeak()
		Return
	EndIf
	int answer = -1
	If Road().HeardKnocking()
		answer = Say("greer_first_heard", captainActor)
	Else
		answer = Say("greer_first", captainActor)
	EndIf
	If answer == 0
		Say("greer_knock", captainActor)
	ElseIf answer == 1
		Say("greer_lamp", captainActor)
	ElseIf answer == 2 && Road().HeardKnocking()
		Fire(true)
	EndIf
EndFunction

Function DornTalk()
	Actor wardenActor = Alias_Dorn.GetActorReference()
	If !TalkOK(wardenActor) || !Road().DornAvailable() || !ShiftSafeToSpeak() || !Road().AtGallery()
		Return
	EndIf
	int answer = Say("dorn_door", wardenActor)
	If answer == 0
		answer = Say("dorn_terms", wardenActor)
		If answer == 0
			Pledge(wardenActor)
		ElseIf answer == 1
			answer = Say("dorn_no_head", wardenActor)
			If answer == 0
				Pledge(wardenActor)
			ElseIf answer == 1 && TalkOK(wardenActor)
				Road().PlanBreak()
			EndIf
		ElseIf answer == 2 && TalkOK(wardenActor)
			Road().PlanBreak()
		EndIf
	ElseIf answer == 1
		Say("dorn_who", wardenActor)
	ElseIf answer == 2 && TalkOK(wardenActor)
		Road().PlanBreak()
	ElseIf answer == 3 && TalkOK(wardenActor)
		TakeLamp(1)
	EndIf
EndFunction

Function Pledge(Actor wardenActor)
	If !TalkOK(wardenActor) || !Road().DornAvailable() || !ShiftSafeToSpeak()
		Return
	EndIf
	If Say("dorn_sworn", wardenActor) == 0 && TalkOK(wardenActor) && ShiftSafeToSpeak()
		Road().MakePact()
	EndIf
EndFunction

Function TakeLamp(int originCode)
	ObjectReference lampRef = Ref(Alias_GalleryLamp)
	If originCode == 2
		lampRef = Ref(Alias_CotLamp)
	EndIf
	If !Near(lampRef) || (Road().LampOrigin() != 0 && !Road().LampPending(originCode))
		Return
	EndIf
	Actor witnessActor = Alias_Dorn.GetActorReference()
	bool witnessed = originCode == 1 && TalkOK(witnessActor) && Road().DornAvailable()
	int answer = Lamp.Show()
	If answer != 0 || !Near(lampRef) || (Road().LampOrigin() != 0 && !Road().LampPending(originCode))
		Return
	EndIf
	If Road().GiveLamp(originCode)
		lampRef.Disable()
		Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
		If witnessed && originCode == 1 && TalkOK(witnessActor) && Road().DornAvailable()
			Say("dorn_lamp", witnessActor)
		EndIf
	EndIf
EndFunction

bool Function MovePlayer(ObjectReference targetRef)
	lastSample = -1.0
	lastArea = 0
	If !Road().PlayerAlive() || !targetRef
		lastSample = -1.0
		lastArea = 0
		Return false
	EndIf
	Game.GetPlayer().MoveTo(targetRef)
	lastSample = -1.0
	lastArea = 0
	bool arrived = Road().PlayerAlive() && Road().At(Game.GetPlayer(),targetRef)
	lastSample = -1.0
	lastArea = 0
	Return arrived
EndFunction

Function UseHoist()
	If !Ready() || !Road().On(Ref(Alias_MouthOpen)) || !Road().Off(Ref(Alias_MouthClosed)) || (Road().MinePending() != 0 && Road().MinePending() != 1) || Road().MineOutcome() != 0
		Return
	EndIf
	If !Road().RescueAccepted()
		; Player-operated fallback if Roark/Blevins is dead, absent or ineligible.
		If !Road().HeardKnocking()
			Return
		EndIf
		If !Road().OperatorReady(Ref(Alias_FiringControl))
			int noOpAnswer = NoOperator.Show()
			If noOpAnswer != 0 || !Ready() || Road().OperatorReady(Ref(Alias_FiringControl)) || !Road().AcceptRescue(false,Ref(Alias_FiringControl))
				Return
			EndIf
		Else
			int clockAnswer = NoWarning.Show()
			If clockAnswer != 0 || !Ready() || !Road().AcceptRescue(false,Ref(Alias_FiringControl))
				Return
			EndIf
		EndIf
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Descend.Show()
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore
		Return
	EndIf
	If Road().MinePending() == 1 || Road().BeginDescent()
		If MovePlayer(Ref(Alias_CageBelow))
			Road().FinishDescent(Ref(Alias_CageBelow))
		EndIf
	EndIf
EndFunction

Function RescueShift()
	If !Ready() || !Road().ShiftFound() || (Road().MinePending() != 0 && Road().MinePending() != 2)
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Rescue.Show()
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore || !Road().BeginRescue()
		Return
	EndIf
	int minerIndex = 0
	While minerIndex < 11
		Actor minerActor = Road().Miner(minerIndex)
		If !Ready() || !minerActor || minerActor.IsDisabled()
			Return
		EndIf
		If minerActor.IsDead()
			; The death must have been observed by the local alias callback or a nearby inspection.
			If Road().Fate(minerIndex) != 4 && !Road().ObserveDeliveredDeath(minerIndex)
				Return
			EndIf
		ElseIf Road().At(minerActor,Ref(SurfaceSlots[minerIndex]))
			Road().ObserveAt(minerIndex,Ref(SurfaceSlots[minerIndex]),3)
		Else
			minerActor.MoveTo(Ref(CageSlots[minerIndex]))
			If !Road().ObserveAt(minerIndex,Ref(CageSlots[minerIndex]),2)
				Return
			EndIf
		EndIf
		minerIndex += 1
	EndWhile
	If !MovePlayer(Ref(Alias_CageSurface))
		Return
	EndIf
	minerIndex = 0
	While minerIndex < 11
		Actor minerActor = Road().Miner(minerIndex)
		If !Ready() || !minerActor || minerActor.IsDisabled()
			Return
		EndIf
		If !minerActor.IsDead() && Road().Fate(minerIndex) != 3
			minerActor.MoveTo(Ref(SurfaceSlots[minerIndex]))
			If !Road().ObserveAt(minerIndex,Ref(SurfaceSlots[minerIndex]),3)
				Return
			EndIf
		EndIf
		minerIndex += 1
	EndWhile
	Road().FinishRescue(SurfaceSlots)
	Facts()
EndFunction

Function BlastBreak()
	If !Near(Ref(Alias_BreakControl)) || (Road().MinePending() != 0 && Road().MinePending() != 3)
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = Blast.Show()
	If answer != 0 || !Near(Ref(Alias_BreakControl)) || Road().MineMark() != mineBefore || !Road().ClearBlastArea(Ref(Alias_BreakClosed),SurfaceSlots,Ref(Alias_BreakControl),Ref(Alias_CageBelow))
		Return
	EndIf
	If Road().MinePending() == 3 || Road().BeginBreak(SurfaceSlots)
		Ref(Alias_BreakOpen).Disable()
		Ref(Alias_BreakClosed).Enable()
		Road().FinishBreak(Ref(Alias_BreakOpen),Ref(Alias_BreakClosed),Ref(Alias_BreakClosed),SurfaceSlots,Ref(Alias_BreakControl),Ref(Alias_CageBelow))
	EndIf
EndFunction

Function Fire(bool ordered)
	If !Ready() || Road().MinePending() != 0 || Road().MineOutcome() != 0 || !Road().HeardKnocking() || !Road().AllBelow(BelowSlots,CageSlots) || !Road().OperatorReady(Ref(Alias_FiringControl))
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = -1
	If ordered
		answer = Seal.Show()
	Else
		answer = Final.Show()
	EndIf
	If answer != 0 || !Ready() || Road().MineMark() != mineBefore || !Road().OperatorReady(Ref(Alias_FiringControl)) || !Road().AllBelow(BelowSlots,CageSlots)
		Road().BlockDeadline()
		Return
	EndIf
	If Road().BeginFire(ordered,Ref(Alias_FiringControl),BelowSlots,CageSlots,Ref(Alias_MouthOpen),Ref(Alias_MouthClosed))
		FinishFiring()
	EndIf
EndFunction

bool Function FiringContext()
	Return Ready() && (Road().MinePending() == 4 || Road().MinePending() == 5) && Road().OperatorReady(Ref(Alias_FiringControl)) && Road().AllBelow(BelowSlots,CageSlots)
EndFunction

Function RestoreAbortedFiring()
	If Road().MineOutcome() == 0
		Road().AbortFiring()
		Ref(Alias_MouthClosed).Disable()
		Ref(Alias_MouthOpen).Enable()
	EndIf
EndFunction

Function ResumeFiring()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	int mineBefore = Road().MineMark()
	int answer = -1
	If Road().MinePending() == 4
		answer = Seal.Show()
	Else
		answer = Final.Show()
	EndIf
	If answer != 0 || Road().MineMark() != mineBefore || !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	FinishFiring()
EndFunction

Function FinishFiring()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	If !MovePlayer(Ref(Alias_CageSurface))
		; Keep the acknowledged intent; the below/surface cage has a labelled retry.
		Return
	EndIf
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Ref(Alias_MouthOpen).Disable()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Ref(Alias_MouthClosed).Enable()
	If !FiringContext()
		RestoreAbortedFiring()
		Return
	EndIf
	Road().FinishFire(Ref(Alias_FiringControl),Ref(Alias_MouthOpen),Ref(Alias_MouthClosed),Ref(Alias_CageSurface),BelowSlots,CageSlots)
EndFunction

Function Facts()
	Road().PublishSurvivors(SurfaceSlots)
	Debug.Notification("Miners safely above ground: " + Road().SafeCount(SurfaceSlots) + ". Deaths witnessed: " + Road().DeathCount() + ".")
	If !Local()
		If Road().ReportDue()
			Debug.Notification("Tell Sheriff Pritchard what happened at Red Hollow.")
		ElseIf Road().TLM_G_MQ02C_Reported.GetValueInt() == 1
			Debug.Notification("Pritchard has heard your report.")
		EndIf
	ElseIf Road().MineOutcome() != 0
		If UndergroundArea()
			Debug.Notification("The work here is finished. Take the hoist back to the yard; the miners already above do not need another rescue.")
		Else
			Debug.Notification("Use Return to Mercy Crossing, then tell Pritchard what happened.")
		EndIf
	ElseIf Road().MinePending() == 3
		If UndergroundArea()
			Debug.Notification("Finish the inner-break work at the Inner-break charge control.")
		Else
			Debug.Notification("Take the hoist below, then use the Inner-break charge control to finish the work.")
		EndIf
	ElseIf Road().MinePending() == 4 || Road().MinePending() == 5
		Debug.Notification("Use the cage or firing control to finish the interrupted firing operation.")
	ElseIf Road().MinePending() == 2
		Debug.Notification("Some miners have not reached safety. Use the hoist control to continue bringing them up, or inspect below.")
	ElseIf UndergroundArea()
		Debug.Notification("Use the hoist to bring the surviving miners up. Returning alone leaves those still below.")
	Else
		Debug.Notification("Use Rescue outcome and pending break plan to decide what happens next.")
	EndIf
EndFunction

Function Used(int who)
	If busy || !Road().PlayerAlive()
		Return
	EndIf
	busy = true
	UseControl(who)
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	UpdateGuidance()
	busy = false
	lastSample = -1.0
EndFunction

Function UseControl(int who)
	If who == 1
		If !Road().Commissioned() || !Near(Ref(Alias_MercyTravel))
			; Mercy is outside Local(); use direct same-cell reach instead.
			If !Road().Commissioned() || !Road().At(Game.GetPlayer(),Ref(Alias_MercyTravel),256.0)
				Return
			EndIf
		EndIf
		int answer = Travel.Show()
		If answer == 0 && Road().Commissioned() && Road().At(Game.GetPlayer(),Ref(Alias_MercyTravel),256.0) && SetUp() && MovePlayer(Ref(Alias_GapArrival))
			Road().ArriveAtGap(Ref(Alias_GapArrival))
		EndIf
		Return
	EndIf
	If !Ready() || !Local()
		Return
	EndIf
	If who == 2 || who == 7 || who == 13
		StagePrisoner()
	EndIf
	If who == 2
		CourtTalk()
	ElseIf who == 3
		RoarkTalk()
	ElseIf who == 32 && Local() && Road().At(Game.GetPlayer(),Ref(Alias_Gallows),512.0)
		Road().FinishExecution(Ref(Alias_Gallows))
	EndIf
	If who == 4
		BlevinsTalk()
	ElseIf who == 5 || who == 28
		DornTalk()
	ElseIf who == 6
		If Near(Ref(Alias_Rope))
			Rope.Show()
		ElseIf Road().CourtPending() == 11
			ReleasePrisoner()
		EndIf
	ElseIf who == 7 || who == 13
		CourtMenu()
	ElseIf who == 8
		Paper("toll_board",Ref(Alias_TollBoard))
	ElseIf who == 9
		Paper("quill_docket",Ref(Alias_Docket))
	ElseIf who == 10
		ReadStatement()
	ElseIf who == 11 && Near(Ref(Alias_TollBox))
		Road().PayToll(Ref(Alias_TollBox))
	ElseIf who == 12 && Near(Ref(Alias_Bypass))
		Road().Bypass()
	ElseIf who == 14 && Near(Ref(Alias_ToMouth))
		TravelLocal(Ref(Alias_ToMouth),Ref(Alias_MouthArrival))
	ElseIf who == 15 && Near(Ref(Alias_ToGap))
		TravelLocal(Ref(Alias_ToGap),Ref(Alias_GapArrival))
	ElseIf who == 16 && Near(Ref(Alias_CageControl))
		If Road().MinePending() == 2
			RecoverRescue()
		ElseIf Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
		Else
			UseHoist()
		EndIf
	ElseIf who == 17 && Near(Ref(Alias_BelowControl))
		If Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
			Return
		EndIf
		int mineBefore = Road().MineMark()
		int answer = HoistBelow.Show()
		If Near(Ref(Alias_BelowControl)) && Road().MineMark() == mineBefore
			If answer == 0
				RescueShift()
			ElseIf answer == 1 && Road().MinePending() == 0
				MovePlayer(Ref(Alias_CageSurface))
			EndIf
		EndIf
	ElseIf who == 18 && Near(Ref(Alias_FiringControl))
		If Road().MinePending() == 4 || Road().MinePending() == 5
			ResumeFiring()
		Else
			Fire(true)
		EndIf
	ElseIf who == 19
		BlastBreak()
	ElseIf who == 20 && Near(Ref(Alias_Roster))
		ObserveNearbyDeaths()
		Road().FindShift(BelowSlots)
		Facts()
	ElseIf who == 21 && Near(Ref(Alias_Gallery))
		If Road().GalleryOpen() && TravelLocal(Ref(Alias_Gallery),Ref(Alias_GalleryArrival))
			Road().VisitGallery(Ref(Alias_GalleryArrival))
		EndIf
	ElseIf who == 22 && Near(Ref(Alias_FromGallery))
		TravelLocal(Ref(Alias_FromGallery),Ref(Alias_CageBelow))
	ElseIf who == 23
		TakeLamp(1)
	ElseIf who == 24
		TakeLamp(2)
	ElseIf who == 25 && Near(Ref(Alias_Silver))
		int answer = Silver.Show()
		If answer == 0 && Near(Ref(Alias_Silver))
			Road().LearnMineSilver()
		EndIf
	ElseIf who == 26
		Paper("chalk_message",Ref(Alias_Shovel))
	ElseIf who == 27 && Near(Ref(Alias_Knocking))
		int answer = Knocking.Show()
		If answer == 0 && Near(Ref(Alias_Knocking))
			Road().HearKnocking()
		EndIf
	ElseIf who == 29 && Near(Ref(Alias_Exit))
		int mineBefore = Road().MineMark()
		int answer = Exit.Show()
		If answer == 0 && Near(Ref(Alias_Exit)) && Road().MineMark() == mineBefore && Road().MinePending() == 0 && MovePlayer(Ref(Alias_MercyReturn))
			If Road().CompleteAtMercy(Ref(Alias_MercyReturn))
				Debug.Notification("Back in Mercy Crossing. Tell Sheriff Pritchard what happened at Red Hollow.")
				End.Show()
			EndIf
		EndIf
	ElseIf who == 30 && Near(Ref(Alias_Resolve))
		int mineBefore = Road().MineMark()
		int answer = Resolve.Show()
		If Near(Ref(Alias_Resolve)) && Road().MineMark() == mineBefore
			If answer == 0
				Road().ResolveRescue(SurfaceSlots,true)
			ElseIf answer == 1
				Road().PlanBreak()
			ElseIf answer == 2
				Road().ResolveCasualties(SurfaceSlots)
			EndIf
		EndIf
		Facts()
	ElseIf who == 31 && Near(Ref(Alias_BodyKey))
		Road().TakeBodyKey()
	ElseIf who == 32
		PrisonerTalk()
	ElseIf who >= 40 && who <= 44
		ShowLabel(who)
	ElseIf who >= 101 && who <= 111
		int minerIndex = who - 101
		If Near(Road().Miner(minerIndex)) && Road().Miner(minerIndex).IsDead()
			Road().ObserveDeath(minerIndex)
		EndIf
		Facts()
	EndIf
EndFunction

bool Function TravelLocal(ObjectReference controlRef, ObjectReference intoRef)
	If !Near(controlRef) || Road().MinePending() != 0
		Return false
	EndIf
	int mineBefore = Road().MineMark()
	int answer = StageTravel.Show()
	If answer != 0 || !Near(controlRef) || Road().MineMark() != mineBefore
		Return false
	EndIf
	If intoRef == Ref(Alias_GalleryArrival) && !Road().GalleryOpen()
		Return false
	EndIf
	Return MovePlayer(intoRef)
EndFunction

Function CourtMenu()
	If !Near(Ref(Alias_CourtRecord)) && !Near(Ref(Alias_Watch))
		Return
	EndIf
	If Road().CourtPending() == 11
		ReleasePrisoner()
		Return
	ElseIf Road().CourtPending() == 14
		If !Road().FinishExecution(Ref(Alias_Gallows)) && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
			int retryAnswer = Drop.Show()
			If retryAnswer == 0 && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
				Road().RequestExecution()
				Road().FinishExecution(Ref(Alias_Gallows))
			EndIf
		EndIf
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Court.Show()
	If !Local() || !Ready() || Road().CourtMark() != courtBefore
		Return
	EndIf
	If answer == 0
		CourtTalk()
	ElseIf answer == 1
		WatchCourt()
	ElseIf answer == 2
		int fineAnswer = Fine.Show()
		If !Local() || !Ready() || Road().CourtMark() != courtBefore || !TalkOK(Alias_Quill.GetActorReference())
			Return
		EndIf
		If fineAnswer == 0
			Road().RecordRope(Ref(Alias_CourtRecord))
		ElseIf fineAnswer == 1
			Road().PayRope(Ref(Alias_TollBox))
		EndIf
	EndIf
EndFunction

Function WatchCourt()
	If !menusRegistered || !Road().CourtOpen() || !TalkOK(Alias_Quill.GetActorReference())
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	int answer = Watch.Show()
	If answer == 0 && Road().CourtMark() == courtBefore && Road().CourtOpen() && TalkOK(Alias_Quill.GetActorReference())
		menuUncertain = false
		Road().BeginWatch()
	EndIf
EndFunction

Function ObserveNearbyDeaths()
	int minerIndex = 0
	While minerIndex < 11
		If Near(Road().Miner(minerIndex),512.0) && Road().Miner(minerIndex).IsDead()
			Road().ObserveDeath(minerIndex)
		EndIf
		minerIndex += 1
	EndWhile
EndFunction

Function ReadStatement()
	If !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
		NoTranscript.Show()
		Return
	EndIf
	string node = "dunmore_tells"
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	If Alias_Condemned.GetActorReference() != original.Alias_CutterLead.GetActorReference()
		node = "cutter_rope"
		If original.TLM_G_CaravanOutcome.GetValueInt() == 4
			node = "cutter_rope_missed"
		EndIf
	EndIf
	If Transcript(node) && Near(Ref(Alias_Transcript)) && Road().HasStatement()
		Road().RecordStatement(true)
	EndIf
EndFunction

Function ShowLabel(int who)
	If who == 40 && Near(Ref(Alias_LabelGap))
		LabelGap.Show()
	ElseIf who == 41 && Near(Ref(Alias_LabelMouth))
		LabelMouth.Show()
	ElseIf who == 42 && Near(Ref(Alias_LabelCage))
		LabelCage.Show()
	ElseIf who == 43 && Near(Ref(Alias_LabelNine))
		LabelNine.Show()
	ElseIf who == 44 && Near(Ref(Alias_LabelGallery))
		LabelGallery.Show()
	EndIf
EndFunction

Function Entered(int who)
	If busy || Utility.IsInMenuMode()
		Return
	EndIf
	If who == 45 && FallContext(Alias_Fall,Alias_CageBelow,5888.0,7936.0,-384.0,1152.0)
		MovePlayer(Ref(Alias_CageBelow))
	ElseIf who == 46 && FallContext(Alias_SurfaceFall,Alias_GapArrival,0.0,4096.0,0.0,1792.0)
		If Game.GetPlayer().GetPositionX() < 1792.0
			MovePlayer(Ref(Alias_GapArrival))
		Else
			MovePlayer(Ref(Alias_MouthArrival))
		EndIf
	ElseIf who == 47 && FallContext(Alias_GalleryFall,Alias_GalleryArrival,8960.0,11008.0,-256.0,1280.0)
		MovePlayer(Ref(Alias_GalleryArrival))
	EndIf
EndFunction

bool Function RecoverFall()
	If busy || Utility.IsInMenuMode()
		Return false
	EndIf
	If FallContext(Alias_Fall,Alias_CageBelow,5888.0,7936.0,-384.0,1152.0)
		Entered(45)
		Return true
	ElseIf FallContext(Alias_SurfaceFall,Alias_GapArrival,0.0,4096.0,0.0,1792.0)
		Entered(46)
		Return true
	ElseIf FallContext(Alias_GalleryFall,Alias_GalleryArrival,8960.0,11008.0,-256.0,1280.0)
		Entered(47)
		Return true
	EndIf
	Return false
EndFunction

bool Function FallContext(ReferenceAlias fallAlias, ReferenceAlias safeAlias, float minX, float maxX, float minY, float maxY)
	If !Ready() || !Road().HasArrived() || !Road().PlayerAlive() || !Ref(fallAlias) || !Ref(safeAlias)
		Return false
	EndIf
	If Game.GetPlayer().GetParentCell() != Ref(fallAlias).GetParentCell() || Ref(safeAlias).GetParentCell() != Ref(fallAlias).GetParentCell() || Game.GetPlayer().GetPositionZ() > -400.0
		Return false
	EndIf
	Return Game.GetPlayer().GetPositionX() >= minX && Game.GetPlayer().GetPositionX() <= maxX && Game.GetPlayer().GetPositionY() >= minY && Game.GetPlayer().GetPositionY() <= maxY
EndFunction

Function HollowActorDied(int who, int causeCode, Actor eventActor)
	If who >= 101 && who <= 111
		Road().RecordDeathEvent(who - 101,eventActor,causeCode)
		If Local() && Near(eventActor,2048.0) && eventActor == Road().Miner(who - 101)
			Road().ObserveDeliveredDeath(who - 101)
		EndIf
	EndIf
	If who == 32 && eventActor == Alias_Condemned.GetActorReference() && Local() && Road().At(Game.GetPlayer(),Ref(Alias_Gallows),512.0)
		Road().FinishExecution(Ref(Alias_Gallows))
	EndIf
	If who == 4 && eventActor == Alias_Blevins.GetActorReference() && eventActor.IsDead()
		Road().AbortDisabledFire(Ref(Alias_FiringControl))
		Road().BlockDeadline()
	EndIf
EndFunction

Function Attacked(int who)
	If who == 5 && Local()
		Actor wardenActor = Alias_Dorn.GetActorReference()
		If wardenActor && !wardenActor.IsDead()
			wardenActor.MoveTo(Ref(Alias_DornWithdraw))
			If Road().At(wardenActor,Ref(Alias_DornWithdraw))
				Road().WithdrawDorn()
			EndIf
		EndIf
	EndIf
EndFunction

Event OnTimer(int aiTimerID)
	If aiTimerID != 1
		Return
	EndIf
	If !busy && !Road().HasArrived() && !IsObjectiveDisplayed(5)
		UpdateGuidance()
	EndIf
	If RecoverFall()
		lastSample = -1.0
		lastArea = 0
		StartTimer(1.0,1)
		Return
	EndIf
	float sampleNow = Utility.GetCurrentRealTime()
	float elapsedSeconds = sampleNow - lastSample
	int currentArea = 0
	If CourtArea()
		currentArea = 1
	ElseIf MineArea()
		currentArea = 2
	EndIf
	bool operatorPaused = false
	If currentArea == 2 && Road().Armed() && Road().MinePending() == 0
		If !Road().OperatorValid(Ref(Alias_FiringControl)) || !Road().AllBelow(BelowSlots,CageSlots)
			Road().BlockDeadline()
		ElseIf !Road().OperatorReady(Ref(Alias_FiringControl))
			operatorPaused = true
		EndIf
	EndIf
	bool eligible = !operatorPaused && menusRegistered && !menuUncertain && !KnownMenuOpen() && !busy && currentArea > 0 && currentArea == lastArea && !Utility.IsInMenuMode() && lastSample >= 0.0 && elapsedSeconds > 0.0 && elapsedSeconds <= 2.5
	lastSample = sampleNow
	lastArea = currentArea
	If Utility.IsInMenuMode() && !KnownMenuOpen()
		menuUncertain = true
		Road().BlockDeadline()
		Road().StopWatching()
	EndIf
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	If eligible && Ready()
		if currentArea == 1
			If Road().TickCourt(elapsedSeconds)
				busy = true
				int courtBefore = Road().CourtMark()
				int answer = Drop.Show()
				If answer == 0 && Local() && TalkOK(Alias_Quill.GetActorReference()) && Road().CourtMark() == courtBefore && Road().BeginExecution()
					Road().RequestExecution()
					Road().FinishExecution(Ref(Alias_Gallows))
				Else
					Road().StopWatching()
				EndIf
				busy = false
				lastSample = -1.0
			EndIf
		ElseIf currentArea == 2
			If Road().Armed() && Road().MinePending() == 0
				If !Road().OperatorValid(Ref(Alias_FiringControl)) || !Road().AllBelow(BelowSlots,CageSlots)
					Road().BlockDeadline()
				ElseIf !Road().OperatorReady(Ref(Alias_FiringControl))
					operatorPaused = true
				ElseIf Road().TickDeadline(elapsedSeconds)
					busy = true
					Fire(false)
					busy = false
					lastSample = -1.0
				EndIf
			EndIf
		EndIf
	EndIf
	If operatorPaused || busy || !Local() || Utility.IsInMenuMode() || KnownMenuOpen() || menuUncertain
		; No absent/menu time is charged; first safe sample only primes the clock.
		lastSample = -1.0
		If operatorPaused
			lastArea = 0
		EndIf
	EndIf
	If !busy && Road().MineOutcome() != 0 && Local() && !IsObjectiveDisplayed(60) && !IsObjectiveDisplayed(85)
		UpdateGuidance()
	EndIf
	samples += 1
	If eligible && samples >= 10 && Road().Armed()
		Debug.Notification("Red Hollow deadline: " + Road().SecondsLeft() + " active seconds; menus and absence pause it.")
		samples = 0
	EndIf
	StartTimer(1.0,1)
EndEvent

int Function OfferReport(Actor sheriffActor)
	If busy || !Road().ReportDue()
		Return 0
	EndIf
	If !ReportContext(sheriffActor)
		Return 3
	EndIf
	Actor reportPlayer = Game.GetPlayer()
	int reportEpoch = aftermathEpoch
	busy = true
	int answer = Report.Show()
	If (!ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch)
		busy = false
		Return 3
	EndIf
	If answer == 1
		busy = false
		Return 2
	EndIf
	If answer != 0
		busy = false
		Return 3
	EndIf
	string node = "pritchard_hears_pike_after_fair_unknown"
	If Road().KnowsMineSilver()
		node = "pritchard_hears_pike_after_fair"
	EndIf
	; Exact source speech under documented completed-road projection, never a fair claim.
	int reply = Say(node,sheriffActor)
	If reply != 0 || (!ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch)
		busy = false
		Return 3
	EndIf
	string reportBefore = ReportMark()
	int detailAnswer = ReportFacts.Show(Road().CourtOutcome(),Road().MineOutcome(),Road().SafeCount(SurfaceSlots),Road().DeathCount(),Road().DeathCauseCount(1),Road().DeathCauseCount(2),Road().DeathCauseCount(3))
	If detailAnswer != 0 || (!ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	reportBefore = ReportMark()
	detailAnswer = ReportEvidence.Show(Road().TLM_G_MQ02C_SilverRoad.GetValueInt(),Road().TLM_G_MQ02C_SilverMine.GetValueInt(),Road().TLM_G_MQ02C_HollowLine.GetValueInt(),Road().TermsDelivered() as int)
	If detailAnswer != 0 || (!ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	reportBefore = ReportMark()
	detailAnswer = ReportLamp.Show(Road().LampOrigin(),Road().TLM_G_MQ02C_LampTaken.GetValueInt(),Road().TLM_G_MQ02C_Docket2298Held.GetValueInt(),Road().TLM_G_MQ02C_Entombed.GetValueInt())
	If detailAnswer != 0 || (!ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	If ReportMark() != reportBefore || !ReportContext(sheriffActor) || reportPlayer != Game.GetPlayer() || reportEpoch != aftermathEpoch
		busy = false
		Return 3
	EndIf
	If !Road().RecordHollowReport(sheriffActor)
		busy = false
		Return 3
	EndIf
	; Only this successful finalizer can authorize the acknowledgment.
	If ReportReceiptContext(sheriffActor,reportBefore,reportEpoch,reportPlayer)
		RhaReport.Show()
	EndIf
	UpdateGuidance()
	busy = false
	Return 1
EndFunction

bool Function ReportContext(Actor sheriffActor)
	Return Road().ReportDue() && Road().PlayerAlive() && sheriffActor && sheriffActor == Road().Person(Road().Alias_Sheriff) && !sheriffActor.IsDead() && !sheriffActor.IsDisabled() && !sheriffActor.IsInCombat() && Road().At(Game.GetPlayer(),sheriffActor,320.0)
EndFunction

bool Function Transcript(string node)
	int answer = -1
	If node == "dunmore_tells"
		answer = T_dunmore_tells_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
		answer = T_dunmore_tells_2.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	ElseIf node == "cutter_rope"
		answer = T_cutter_rope_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	ElseIf node == "cutter_rope_missed"
		answer = T_cutter_rope_missed_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	Else
		Return false
	EndIf
	Return true
EndFunction

bool Function SpeechContext(string node, Actor speakerActor)
	If !TalkOK(speakerActor)
		Return false
	EndIf
	If node == "pritchard_hears_pike_after_fair" || node == "pritchard_hears_pike_after_fair_unknown"
		Return ReportContext(speakerActor)
	EndIf
	If node == "quill_court" || node == "quill_court_docket" || node == "quill_fine" || node == "quill_shamed"
		Return Road().CourtOpen()
	EndIf
	If node == "roark_mouth" || node == "roark_why" || node == "roark_back" || node == "roark_deadline_warning" || node == "roark_cage"
		Return ShiftSafeToSpeak() && Road().OperatorReady(Ref(Alias_FiringControl))
	EndIf
	If node == "greer_first" || node == "greer_first_heard" || node == "greer_knock" || node == "greer_lamp"
		Return ShiftSafeToSpeak()
	EndIf
	If node == "dorn_door" || node == "dorn_terms" || node == "dorn_no_head" || node == "dorn_sworn" || node == "dorn_who"
		Return Road().DornAvailable() && ShiftSafeToSpeak()
	EndIf
	If node == "dorn_lamp"
		Return Road().DornAvailable() && Road().LampOrigin() == 1
	EndIf
	Return true
EndFunction


