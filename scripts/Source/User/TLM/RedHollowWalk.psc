Function HollowActorDied(int who, int causeCode, Actor eventActor)
	If who >= 101 && who <= 111
		Road().RecordDeathEvent(who - 101,eventActor,causeCode)
		If Local() && Near(eventActor,2048.0) && eventActor == Road().Miner(who - 101)
			Road().ObserveDeliveredDeath(who - 101)
		EndIf
	EndIf
	If who == 32 && eventActor == Alias_Condemned.GetActorReference() && Local() && Road().At(Game.GetPlayer(),Ref(Alias_Gallows),512.0)
		Road().FinishExecution(Ref(Alias_Gallows))
	EndIf
	If who == 4 && eventActor == Alias_Blevins.GetActorReference() && eventActor.IsDead()
		Road().AbortDisabledFire(Ref(Alias_FiringControl))
		Road().BlockDeadline()
	EndIf
EndFunction

Function Attacked(int who)
	If who == 5 && Local()
		Actor wardenActor = Alias_Dorn.GetActorReference()
		If wardenActor && !wardenActor.IsDead()
			wardenActor.MoveTo(Ref(Alias_DornWithdraw))
			If Road().At(wardenActor,Ref(Alias_DornWithdraw))
				Road().WithdrawDorn()
			EndIf
		EndIf
	EndIf
EndFunction

Event OnTimer(int aiTimerID)
	If aiTimerID != 1
		Return
	EndIf
	float sampleNow = Utility.GetCurrentRealTime()
	float elapsedSeconds = sampleNow - lastSample
	int currentArea = 0
	If CourtArea()
		currentArea = 1
	ElseIf MineArea()
		currentArea = 2
	EndIf
	bool eligible = menusRegistered && !menuUncertain && !KnownMenuOpen() && !busy && currentArea > 0 && currentArea == lastArea && !Utility.IsInMenuMode() && lastSample >= 0.0 && elapsedSeconds > 0.0 && elapsedSeconds <= 2.5
	lastSample = sampleNow
	lastArea = currentArea
	If Utility.IsInMenuMode() && !KnownMenuOpen()
		menuUncertain = true
		Road().BlockDeadline()
		Road().StopWatching()
	EndIf
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	If eligible && Ready()
		if currentArea == 1
			If Road().TickCourt(elapsedSeconds)
				busy = true
				int courtBefore = Road().CourtMark()
				int answer = Drop.Show()
				If answer == 0 && Local() && TalkOK(Alias_Quill.GetActorReference()) && Road().CourtMark() == courtBefore && Road().BeginExecution()
					Road().RequestExecution()
					Road().FinishExecution(Ref(Alias_Gallows))
				Else
					Road().StopWatching()
				EndIf
				busy = false
				lastSample = -1.0
			EndIf
		ElseIf currentArea == 2
			If Road().Armed() && Road().MinePending() == 0
				If !Road().OperatorReady(Ref(Alias_FiringControl)) || !Road().AllBelow(BelowSlots,CageSlots)
					Road().BlockDeadline()
				ElseIf Road().TickDeadline(elapsedSeconds)
					busy = true
					Fire(false)
					busy = false
					lastSample = -1.0
				EndIf
			EndIf
		EndIf
	EndIf
	If busy || !Local() || Utility.IsInMenuMode() || KnownMenuOpen() || menuUncertain
		; No absent/menu time is charged; first safe sample only primes the clock.
		lastSample = -1.0
	EndIf
	samples += 1
	If eligible && samples >= 10 && Road().Armed()
		Debug.Notification("Red Hollow deadline: " + Road().SecondsLeft() + " active seconds; menus and absence pause it.")
		samples = 0
	EndIf
	StartTimer(1.0,1)
EndEvent

int Function OfferReport(Actor sheriffActor)
	If busy || !Road().ReportDue()
		Return 0
	EndIf
	If !ReportContext(sheriffActor)
		Return 3
	EndIf
	busy = true
	int answer = Report.Show()
	If !ReportContext(sheriffActor)
		busy = false
		Return 3
	EndIf
	If answer == 1
		busy = false
		Return 2
	EndIf
	If answer != 0
		busy = false
		Return 3
	EndIf
	string node = "pritchard_hears_pike_after_fair_unknown"
	If Road().KnowsMineSilver()
		node = "pritchard_hears_pike_after_fair"
	EndIf
	; Exact source speech under documented completed-road projection, never a fair claim.
	int reply = Say(node,sheriffActor)
	If reply != 0 || !ReportContext(sheriffActor)
		busy = false
		Return 3
	EndIf
	string reportBefore = ReportMark()
	int detailAnswer = ReportFacts.Show(Road().CourtOutcome(),Road().MineOutcome(),Road().SafeCount(SurfaceSlots),Road().DeathCount(),Road().DeathCauseCount(1),Road().DeathCauseCount(2),Road().DeathCauseCount(3))
	If detailAnswer != 0 || !ReportContext(sheriffActor) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	reportBefore = ReportMark()
	detailAnswer = ReportEvidence.Show(Road().TLM_G_MQ02C_SilverRoad.GetValueInt(),Road().TLM_G_MQ02C_SilverMine.GetValueInt(),Road().TLM_G_MQ02C_HollowLine.GetValueInt(),Road().TermsDelivered() as int)
	If detailAnswer != 0 || !ReportContext(sheriffActor) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	Road().RefreshEvidence(TLM_MercyBriefing as TLM:MercyBriefing)
	reportBefore = ReportMark()
	detailAnswer = ReportLamp.Show(Road().LampOrigin(),Road().TLM_G_MQ02C_LampTaken.GetValueInt(),Road().TLM_G_MQ02C_Docket2298Held.GetValueInt(),Road().TLM_G_MQ02C_Entombed.GetValueInt())
	If detailAnswer != 0 || !ReportContext(sheriffActor) || ReportMark() != reportBefore
		busy = false
		Return 3
	EndIf
	If !Road().RecordHollowReport(sheriffActor)
		busy = false
		Return 3
	EndIf
	Facts()
	busy = false
	Return 1
EndFunction

bool Function ReportContext(Actor sheriffActor)
	Return Road().ReportDue() && Road().PlayerAlive() && sheriffActor && sheriffActor == Road().Person(Road().Alias_Sheriff) && !sheriffActor.IsDead() && !sheriffActor.IsDisabled() && !sheriffActor.IsInCombat() && Road().At(Game.GetPlayer(),sheriffActor,320.0)
EndFunction

bool Function Transcript(string node)
	int answer = -1
	If node == "dunmore_tells"
		answer = T_dunmore_tells_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
		answer = T_dunmore_tells_2.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	ElseIf node == "cutter_rope"
		answer = T_cutter_rope_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	ElseIf node == "cutter_rope_missed"
		answer = T_cutter_rope_missed_1.Show()
		If answer != 0 || !Near(Ref(Alias_Transcript)) || !Road().HasStatement()
			Return false
		EndIf
	Else
		Return false
	EndIf
	Return true
EndFunction

bool Function SpeechContext(string node, Actor speakerActor)
	If !TalkOK(speakerActor)
		Return false
	EndIf
	If node == "pritchard_hears_pike_after_fair" || node == "pritchard_hears_pike_after_fair_unknown"
		Return ReportContext(speakerActor)
	EndIf
	If node == "quill_court" || node == "quill_court_docket" || node == "quill_fine" || node == "quill_shamed"
		Return Road().CourtOpen()
	EndIf
	If node == "roark_mouth" || node == "roark_why" || node == "roark_back" || node == "roark_deadline_warning" || node == "roark_cage"
		Return ShiftSafeToSpeak() && Road().OperatorReady(Ref(Alias_FiringControl))
	EndIf
	If node == "greer_first" || node == "greer_first_heard" || node == "greer_knock" || node == "greer_lamp"
		Return ShiftSafeToSpeak()
	EndIf
	If node == "dorn_door" || node == "dorn_terms" || node == "dorn_no_head" || node == "dorn_sworn" || node == "dorn_who"
		Return Road().DornAvailable() && ShiftSafeToSpeak()
	EndIf
	If node == "dorn_lamp"
		Return Road().DornAvailable() && Road().LampOrigin() == 1
	EndIf
	Return true
EndFunction


