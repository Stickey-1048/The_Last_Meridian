bool Function Paper(string paperId, ObjectReference paperRef)
	If !Near(paperRef)
		Return false
	EndIf
	int answer = -1
	If paperId == "toll_board"
		answer = D_toll_board_1.Show()
		If answer != 0 || !Near(paperRef)
			Return false
		EndIf
		answer = D_toll_board_2.Show()
