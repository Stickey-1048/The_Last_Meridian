bool Function SetUp()
	If !IsRunning() || !Road().Commissioned()
		Return false
	EndIf
	If !TLM_MQ02C.IsRunning()
		If !TLM_MQ02C.Start() || !TLM_MQ02C.IsRunning()
			Return false
		EndIf
	EndIf
	RegisterClockMenus()
	If setUpDone
		StagePrisoner()
		Return true
	EndIf
	int castIndex = 0
	While castIndex < CastFrom.Length
		If !Ref(CastFrom[castIndex])
			Return false
		EndIf
		CastInto[castIndex].ForceRefTo(Ref(CastFrom[castIndex]))
		castIndex += 1
	EndWhile
	castIndex = 0
	While castIndex < ZoneOn.Length
		If Ref(ZoneOn[castIndex])
			Ref(ZoneOn[castIndex]).Enable()
		EndIf
		castIndex += 1
	EndWhile
	setUpDone = Road().DistinctRoster()
	Road().GiveKey()
	StagePrisoner()
	ArmRope()
	Return setUpDone
EndFunction

Function StagePrisoner()
	If !IsRunning() || !TLM_MQ02C.IsRunning() || !setUpDone || !Road().Commissioned() || Road().HasPrisoner() || Road().CourtOutcome() != 0 || Road().CourtPending() != 0 || Ref(Alias_Condemned)
		Return
	EndIf
	TLM:MQ01Quest original = TLM_MQ01 as TLM:MQ01Quest
	If !original
		Return
	EndIf
	Actor candidate = original.Alias_CutterLead.GetActorReference()
	int roleIndex = 1
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterA.GetActorReference()
		roleIndex = 2
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterB.GetActorReference()
		roleIndex = 3
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		candidate = original.Alias_CutterC.GetActorReference()
		roleIndex = 4
	EndIf
	If !candidate || candidate.IsDead() || candidate.IsInCombat()
		Return
	EndIf
	candidate.Enable()
	candidate.MoveTo(Ref(Alias_Gallows))
	If Road().BindPrisoner(candidate, roleIndex, Ref(Alias_Gallows))
		Alias_Condemned.ForceRefTo(candidate)
	EndIf
EndFunction

Function ArmRope()
	If Road() && Road().CourtOutcome() == 0 && Ref(Alias_Rope)
		; ScriptObject registration is single-shot; rejected hits and load rearm it.
		RegisterForHitEvent(Ref(Alias_Rope), Game.GetPlayer())
	EndIf
EndFunction

Event OnHit(ObjectReference akTarget, ObjectReference akAggressor, Form akSource, Projectile akProjectile, bool abPowerAttack, bool abSneakAttack, bool abBashAttack, bool abHitBlocked, string asMaterialName)
	If !busy && Local() && akTarget == Ref(Alias_Rope) && akAggressor == Game.GetPlayer() && akProjectile && !abBashAttack && !abHitBlocked && Road().StartRope(akTarget, true)
		busy = true
		ReleasePrisoner()
		busy = false
		lastSample = -1.0
	EndIf
	ArmRope()
EndEvent

bool Function ReleasePrisoner()
	Actor prisonerActor = Alias_Condemned.GetActorReference()
	If !Ready() || !prisonerActor || prisonerActor.IsDead() || prisonerActor.IsInCombat()
		Return false
	EndIf
	If Road().CourtPending() == 11
		Ref(Alias_Rope).Disable()
		Ref(Alias_RopeBroken).Enable()
	EndIf
	prisonerActor.MoveTo(Ref(Alias_Released))
	If Road().FinishRelease(Ref(Alias_Released), Ref(Alias_Rope), Ref(Alias_RopeBroken))
		; Only the confirmed original arrival earns a release acknowledgment.
		AcknowledgeRelease(prisonerActor)
		Return true
	EndIf
	Return false
EndFunction

Function AcknowledgeRelease(Actor releasedActor)
	If !Ready() || !releasedActor || releasedActor.IsDead() || releasedActor.IsDisabled() || (Road().CourtOutcome() != 11 && Road().CourtOutcome() != 12) || !Road().At(releasedActor,Ref(Alias_Released))
		Return
	EndIf
	If releasedActor != Alias_Condemned.GetActorReference() || releasedActor != Road().Person(Road().Alias_Condemned)
		Return
	EndIf
	SetObjectiveDisplayed(70,true)
	Debug.Notification("Freed prisoner: I'm clear of the rope.")
	Debug.Notification("The prisoner waits beside the court.")
EndFunction

Function UpdateGuidance()
	{Read-only directions: no rescue, court, evidence or mine outcome is changed.}
	If !IsRunning() || !Road().Commissioned()
		Return
	EndIf
	int nextGoal = 0
	If !Road().HasArrived()
		nextGoal = 5
	ElseIf Local()
		If SurfaceArea() && Game.GetPlayer().GetPositionX() < 1792.0
			nextGoal = 10
		ElseIf UndergroundArea()
			If Game.GetPlayer().GetPositionX() >= 8960.0
				nextGoal = 80
			ElseIf Road().MineOutcome() != 0
				nextGoal = 85
			ElseIf Road().MinePending() == 3
				nextGoal = 55
			ElseIf Road().MinePending() == 4 || Road().MinePending() == 5
				nextGoal = 86
			ElseIf Road().ShiftFound()
				nextGoal = 40
			Else
				nextGoal = 30
			EndIf
		ElseIf Road().MineOutcome() != 0
			nextGoal = 60
		ElseIf Road().MinePending() == 2 || Road().MinePending() == 3 || Road().MinePending() == 4 || Road().MinePending() == 5
			nextGoal = 20
		ElseIf Road().SafeCount(SurfaceSlots) > 0
			nextGoal = 50
		Else
			nextGoal = 20
		EndIf
	EndIf
	If !Local() && Road().ReportDue()
		Actor reportRecipient = Road().Person(Road().Alias_Sheriff)
		If reportRecipient && !reportRecipient.IsDead() && !reportRecipient.IsDisabled()
			Alias_GuideSheriff.ForceRefTo(reportRecipient)
			If Alias_GuideSheriff.GetActorReference() == Road().Person(Road().Alias_Sheriff)
				nextGoal = 90
			EndIf
		EndIf
	EndIf
	int index = 5
	While index <= 90
		If index == 5 || index == 10 || index == 20 || index == 30 || index == 40 || index == 50 || index == 55 || index == 60 || index == 80 || index == 85 || index == 90
			SetObjectiveDisplayed(index,index == nextGoal)
		EndIf
		index += 5
	EndWhile
	SetObjectiveDisplayed(86,nextGoal == 86)
	If !Local() || !SurfaceArea() || Game.GetPlayer().GetPositionX() >= 1792.0
		SetObjectiveDisplayed(70,false)
	EndIf
EndFunction

bool Function ShiftSafeToSpeak()
	Return Road().AllAliveBelow(BelowSlots) && Road().MineOutcome() == 0 && Road().MinePending() == 0
EndFunction

Function CourtTalk()
	Actor judgeActor = Alias_Quill.GetActorReference()
	If !TalkOK(judgeActor)
		Return
	EndIf
	If Road().ReferralDue()
		ReferDockets()
		Return
	EndIf
	If Road().CourtPending() == 12
		FineRelease()
		Return
	EndIf
	If Road().CourtPending() == 13
		Custody()
		Return
	EndIf
	If !Ref(Alias_Condemned)
		Unavailable.Show()
		Return
	EndIf
	If !Road().CourtOpen()
		Status.Show()
		Return
	EndIf
	int courtBefore = Road().CourtMark()
	bool heldCopy = Road().HoldsDocket()
	int answer = -1
	If heldCopy
		answer = Say("quill_court_docket", judgeActor)
	Else
		answer = Say("quill_court", judgeActor)
	EndIf
	If answer == -1 || !TalkOK(judgeActor) || Road().CourtMark() != courtBefore || !Road().CourtOpen()
		Return
	EndIf
	If answer == 0
		If Say("quill_fine", judgeActor) == 0 && TalkOK(judgeActor) && Road().CourtMark() == courtBefore && Road().CourtOpen()
			FineRelease()
		EndIf
	ElseIf answer == 1 && heldCopy && Road().HoldsDocket()
		If Say("quill_shamed", judgeActor) == 0 && TalkOK(judgeActor) && Road().HoldsDocket() && Road().CourtMark() == courtBefore && Road().StartAdjournment()
			Custody()
		EndIf
	EndIf
EndFunction

Function FineRelease()
	If !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned)
		Return
	EndIf
	If Road().StartFine(Ref(Alias_TollBox)) && Road().GiveReceipt()
		int answer = Receipt.Show()
		If answer == 0 && TalkOK(Alias_Quill.GetActorReference()) && Road().Speaking(Alias_Condemned)
			ReleasePrisoner()
		EndIf
	EndIf
EndFunction

Function Custody()
	If !TalkOK(Alias_Quill.GetActorReference()) || !Road().Speaking(Alias_Condemned) || !Road().HoldsDocket()
		Return
	EndIf
	Alias_Condemned.GetActorReference().MoveTo(Ref(Alias_Custody))
