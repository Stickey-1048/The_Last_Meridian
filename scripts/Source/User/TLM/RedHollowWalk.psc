TLM:MQ02CQuest Function Road()
	Return TLM_MQ02C as TLM:MQ02CQuest
EndFunction

ObjectReference Function Ref(ReferenceAlias a)
	If !a
		Return None
	EndIf
	Return a.GetReference()
EndFunction

bool Function Ready()
	Return Road() && Road().Open()
EndFunction

bool Function Local()
	Return Road().PlayerAlive() && Game.GetPlayer().Is3DLoaded() && (SurfaceArea() || UndergroundArea())
EndFunction

bool Function SurfaceArea()
	If !Ref(Alias_GapArrival) || Game.GetPlayer().GetParentCell() != Ref(Alias_GapArrival).GetParentCell()
		Return false
	EndIf
	float x = Game.GetPlayer().GetPositionX()
	float y = Game.GetPlayer().GetPositionY()
	Return (x >= -128.0 && x <= 1664.0 && y >= -128.0 && y <= 896.0) || (x >= 1920.0 && x <= 3840.0 && y >= -128.0 && y <= 1408.0)
EndFunction

bool Function UndergroundArea()
	If !Ref(Alias_CageBelow) || Game.GetPlayer().GetParentCell() != Ref(Alias_CageBelow).GetParentCell()
		Return false
	EndIf
	float x = Game.GetPlayer().GetPositionX()
	float y = Game.GetPlayer().GetPositionY()
	Return (x >= 6016.0 && x <= 7808.0 && y >= -128.0 && y <= 896.0) || (x >= 9088.0 && x <= 10624.0 && y >= -128.0 && y <= 896.0)
EndFunction

bool Function Near(ObjectReference targetRef, float reach = 256.0)
	Return Local() && Road().On(targetRef) && Road().At(Game.GetPlayer(),targetRef,reach)
EndFunction

bool Function TalkOK(Actor speakerActor)
	Return Road().PlayerAlive() && Road().HasArrived() && speakerActor && !speakerActor.IsDead() && !speakerActor.IsDisabled() && !speakerActor.IsInCombat() && speakerActor.Is3DLoaded() && Road().At(Game.GetPlayer(),speakerActor,320.0)
EndFunction

